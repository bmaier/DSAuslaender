@prefix : <http://bamf.de/ontology/dsauslaender#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cpov: <http://data.europa.eu/m8g/> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix cvb: <http://data.europa.eu/m8g/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix cpev: <http://data.europa.eu/m8g/> .
@prefix emn: <https://home-affairs.ec.europa.eu/emn/glossary#> .
@prefix euauth: <http://publications.europa.eu/resource/authority/> .

<http://bamf.de/ontology/dsauslaender> a owl:Ontology ;
    dct:title "DSAusländer Ontologie"@de ,
              "Foreigners Data Ontology"@en ;
    dct:description "W3C-Ontologie für das DSAusländer-Register des Bundesamts für Migration und Flüchtlinge (BAMF)"@de ,
                    "W3C ontology for the DSAusländer (Foreigners Data) register of the Federal Office for Migration and Refugees (BAMF)"@en ;
    dct:created "2025-01-19"^^xsd:date ;
    dct:modified "2025-01-19"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.0" ;
    rdfs:comment "Diese Ontologie basiert auf den EU Core Vocabularies (Person, Location, Business, Public Event, CPSV-AP, CPOV) und referenziert das EMN Asylum and Migration Glossary sowie EU Authority Tables. SKOS-Vokabulare sind in separaten Dateien definiert."@de ;
    owl:imports <http://data.europa.eu/m8g> ,
                <http://www.w3.org/ns/locn> ,
                <http://purl.org/vocab/cpsv> ;
    # Referenzen zu SKOS-Vokabularen
    rdfs:seeAlso <http://bamf.de/vocabulary/geschlecht> ,
                 <http://bamf.de/vocabulary/staatsangehoerigkeit> ,
                 <http://bamf.de/vocabulary/aufenthaltstitel> ,
                 <http://bamf.de/vocabulary/familienstand> ,
                 <http://bamf.de/vocabulary/asylentscheidung> ,
                 <http://bamf.de/vocabulary/aufenthaltszweck> ,
                 <http://bamf.de/vocabulary/sensitivitaet> .

# ============================================================================
# KLASSEN (Classes)
# ============================================================================

# Hauptklasse für ausländische Person
:AuslaendischePerson a owl:Class ;
    rdfs:subClassOf cpov:Person ;
    rdfs:label "Ausländische Person"@de ,
               "Foreign Person"@en ;
    rdfs:comment "Eine Person, die nicht die deutsche Staatsangehörigkeit besitzt und im DSAusländer-Register erfasst ist. Basiert auf dem EMN-Glossar für Drittstaatsangehörige."@de ,
                 "A person who does not hold German citizenship and is registered in the DSAusländer register. Based on the EMN glossary for third-country nationals."@en ;
    skos:related emn:third-country-national .

# Aufenthaltsstatus
:Aufenthaltsstatus a owl:Class ;
    rdfs:label "Aufenthaltsstatus"@de ,
               "Residence Status"@en ;
    rdfs:comment "Der rechtliche Status des Aufenthalts einer ausländischen Person in Deutschland"@de ,
                 "The legal status of a foreign person's residence in Germany"@en ;
    skos:related emn:residence-permit , emn:immigration-status .

# Aufenthaltstitel
:Aufenthaltstitel a owl:Class ;
    rdfs:label "Aufenthaltstitel"@de ,
               "Residence Permit"@en ;
    rdfs:comment "Offizielles Dokument, das einer ausländischen Person das Recht gewährt, sich in Deutschland aufzuhalten"@de ,
                 "Official document granting a foreign person the right to reside in Germany"@en ;
    skos:related emn:residence-permit .

# Asylverfahren
:Asylverfahren a owl:Class ;
    rdfs:subClassOf cpev:PublicEvent ;
    rdfs:label "Asylverfahren"@de ,
               "Asylum Procedure"@en ;
    rdfs:comment "Verwaltungsverfahren zur Prüfung eines Asylantrags gemäß EMN-Glossar"@de ,
                 "Administrative procedure for examining an asylum application according to EMN glossary"@en ;
    skos:related emn:asylum-procedure , emn:asylum-application .

# Asylantrag
:Asylantrag a owl:Class ;
    rdfs:label "Asylantrag"@de ,
               "Asylum Application"@en ;
    rdfs:comment "Förmlicher Antrag auf internationalen Schutz gemäß EMN-Glossar"@de ,
                 "Formal application for international protection according to EMN glossary"@en ;
    skos:related emn:asylum-application , emn:international-protection .

# Entscheidung im Asylverfahren
:Asylentscheidung a owl:Class ;
    rdfs:label "Asylentscheidung"@de ,
               "Asylum Decision"@en ;
    rdfs:comment "Behördliche Entscheidung über einen Asylantrag"@de ,
                 "Official decision on an asylum application"@en ;
    skos:related emn:asylum-decision , emn:final-decision .

# Staatsangehörigkeit
:Staatsangehoerigkeit a owl:Class ;
    rdfs:label "Staatsangehörigkeit"@de ,
               "Citizenship"@en ;
    rdfs:comment "Die rechtliche Zugehörigkeit einer Person zu einem Staat"@de ,
                 "The legal belonging of a person to a state"@en ;
    skos:related emn:citizenship , emn:nationality .

# Adresse
:Adresse a owl:Class ;
    rdfs:subClassOf locn:Address ;
    rdfs:label "Adresse"@de ,
               "Address"@en ;
    rdfs:comment "Postanschrift einer Person in Deutschland"@de ,
                 "Postal address of a person in Germany"@en .

# Dokument
:Dokument a owl:Class ;
    rdfs:subClassOf foaf:Document ;
    rdfs:label "Dokument"@de ,
               "Document"@en ;
    rdfs:comment "Offizielles Dokument im Zusammenhang mit dem Aufenthalt"@de ,
                 "Official document related to residence"@en .

# Reisedokument
:Reisedokument a owl:Class ;
    rdfs:subClassOf :Dokument ;
    rdfs:label "Reisedokument"@de ,
               "Travel Document"@en ;
    rdfs:comment "Pass oder anderes Dokument zur Identifizierung und Reise"@de ,
                 "Passport or other document for identification and travel"@en ;
    skos:related emn:travel-document .

# Behörde
:Behoerde a owl:Class ;
    rdfs:subClassOf cvb:PublicOrganisation ;
    rdfs:label "Behörde"@de ,
               "Public Authority"@en ;
    rdfs:comment "Öffentliche Behörde, die im Ausländerwesen tätig ist"@de ,
                 "Public authority active in immigration matters"@en .

# Visa
:Visum a owl:Class ;
    rdfs:subClassOf :Dokument ;
    rdfs:label "Visum"@de ,
               "Visa"@en ;
    rdfs:comment "Erlaubnis zur Einreise und zum Aufenthalt für einen bestimmten Zeitraum"@de ,
                 "Permission to enter and stay for a specific period"@en ;
    skos:related emn:visa .

# Abschiebung
:Abschiebung a owl:Class ;
    rdfs:subClassOf cpev:PublicEvent ;
    rdfs:label "Abschiebung"@de ,
               "Deportation"@en ;
    rdfs:comment "Zwangsweise Rückführung einer ausländischen Person gemäß EMN-Glossar"@de ,
                 "Forced return of a foreign person according to EMN glossary"@en ;
    skos:related emn:deportation , emn:forced-return .

# Duldung
:Duldung a owl:Class ;
    rdfs:subClassOf :Aufenthaltsstatus ;
    rdfs:label "Duldung"@de ,
               "Toleration"@en ;
    rdfs:comment "Vorübergehende Aussetzung der Abschiebung gemäß EMN-Glossar"@de ,
                 "Temporary suspension of deportation according to EMN glossary"@en ;
    skos:related emn:tolerated-stay .

# Erwerbstätigkeit
:Erwerbstaetigkeit a owl:Class ;
    rdfs:label "Erwerbstätigkeit"@de ,
               "Employment"@en ;
    rdfs:comment "Berufliche Tätigkeit einer ausländischen Person in Deutschland"@de ,
                 "Professional activity of a foreign person in Germany"@en ;
    skos:related emn:employment .

# Familienangehöriger
:Familienangehoeriger a owl:Class ;
    rdfs:subClassOf cpov:Person ;
    rdfs:label "Familienangehöriger"@de ,
               "Family Member"@en ;
    rdfs:comment "Familienangehöriger einer ausländischen Person gemäß EMN-Glossar zum Familiennachzug"@de ,
                 "Family member of a foreign person according to EMN glossary on family reunification"@en ;
    skos:related emn:family-member , emn:family-reunification .

# Integrationskurs
:Integrationskurs a owl:Class ;
    rdfs:subClassOf cpsv:PublicService ;
    rdfs:label "Integrationskurs"@de ,
               "Integration Course"@en ;
    rdfs:comment "Staatlich geförderter Kurs zur Integration in Deutschland"@de ,
                 "State-funded course for integration in Germany"@en ;
    skos:related emn:integration .

# ============================================================================
# OBJECT PROPERTIES (Beziehungen)
# ============================================================================

# Aufenthaltstitel-Beziehungen
:hatAufenthaltstitel a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Aufenthaltstitel ;
    rdfs:label "hat Aufenthaltstitel"@de ,
               "has residence permit"@en ;
    rdfs:comment "Verknüpft eine Person mit ihrem Aufenthaltstitel"@de .

:hatAufenthaltsstatus a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Aufenthaltsstatus ;
    rdfs:label "hat Aufenthaltsstatus"@de ,
               "has residence status"@en .

# Staatsangehörigkeit
:hatStaatsangehoerigkeit a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Staatsangehoerigkeit ;
    rdfs:label "hat Staatsangehörigkeit"@de ,
               "has citizenship"@en ;
    rdfs:comment "Verknüpft eine Person mit ihrer Staatsangehörigkeit"@de .

# Adresse
:hatAdresse a owl:ObjectProperty ;
    rdfs:subPropertyOf locn:address ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Adresse ;
    rdfs:label "hat Adresse"@de ,
               "has address"@en .

# Asylverfahren
:hatAsylverfahren a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Asylverfahren ;
    rdfs:label "hat Asylverfahren"@de ,
               "has asylum procedure"@en .

:hatAsylantrag a owl:ObjectProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range :Asylantrag ;
    rdfs:label "hat Asylantrag"@de ,
               "has asylum application"@en .

:hatEntscheidung a owl:ObjectProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range :Asylentscheidung ;
    rdfs:label "hat Entscheidung"@de ,
               "has decision"@en .

# Dokumente
:hatReisedokument a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Reisedokument ;
    rdfs:label "hat Reisedokument"@de ,
               "has travel document"@en .

:hatVisum a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Visum ;
    rdfs:label "hat Visum"@de ,
               "has visa"@en .

# Behörden
:bearbeitetVon a owl:ObjectProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range :Behoerde ;
    rdfs:label "bearbeitet von"@de ,
               "processed by"@en .

:zustaendigeBehoerde a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Behoerde ;
    rdfs:label "zuständige Behörde"@de ,
               "responsible authority"@en .

# Abschiebung
:hatAbschiebung a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Abschiebung ;
    rdfs:label "hat Abschiebung"@de ,
               "has deportation"@en .

# Duldung
:hatDuldung a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Duldung ;
    rdfs:label "hat Duldung"@de ,
               "has toleration"@en .

# Erwerbstätigkeit
:hatErwerbstaetigkeit a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Erwerbstaetigkeit ;
    rdfs:label "hat Erwerbstätigkeit"@de ,
               "has employment"@en .

# Familie
:hatFamilienangeh oeriger a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Familienangeh oeriger ;
    rdfs:label "hat Familienangehöriger"@de ,
               "has family member"@en .

# Integration
:nimmtTeilAn a owl:ObjectProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range :Integrationskurs ;
    rdfs:label "nimmt teil an"@de ,
               "participates in"@en .

# Verweist auf EU Authority Tables
:euAuthority a owl:ObjectProperty ;
    rdfs:label "EU Authority"@de ,
               "EU Authority"@en ;
    rdfs:comment "Referenz auf EU Authority Tables (z.B. EUAA)"@de ;
    rdfs:range euauth:CorporateBody .

# ============================================================================
# DATATYPE PROPERTIES (Attribute)
# ============================================================================

# --- Behörden-Attribute ---

:aktenfuehrendeBehoerde a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Aktenführende Behörde"@de ,
               "File-Managing Authority"@en ;
    rdfs:comment "Die Behörde, die die Ausländerakte führt (Datenelement 001)"@de .


:registerbeh oerde a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Registerbehörde"@de ,
               "Registration Authority"@en ;
    rdfs:comment "Die das Ausländerzentralregister führende Behörde (Datenelement 003)"@de .

:auslaendernummer a owl:DatatypeProperty ;
    rdfs:subPropertyOf dct:identifier ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Ausländernummer"@de ,
               "Foreigner Number"@en ;
    rdfs:comment "Eindeutige Ausländernummer (Datenelement 004)"@de .

# Personendaten (basierend auf cpov:Person)
:personenID a owl:DatatypeProperty ;
    rdfs:subPropertyOf dct:identifier ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Personen-ID"@de ,
               "Person ID"@en ;
    rdfs:comment "Eindeutige Identifikationsnummer im DSAusländer-Register"@de .


:vorname a owl:DatatypeProperty ;
    rdfs:subPropertyOf foaf:givenName ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Vorname"@de ,
               "Given Name"@en .





:fruehererName a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Früherer Name"@de ,
               "Former Name"@en ;
    rdfs:comment "Frühere(r) Name(n) (Datenelement 012)"@de .

:aliasnamen a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Aliasnamen"@de ,
               "Alias Names"@en ;
    rdfs:comment "Aliasnamen (Datenelement 013)"@de .

:schriftzeichen a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Schriftzeichen"@de ,
               "Characters/Script"@en ;
    rdfs:comment "Namenswiedergabe in Originalschrift (z.B. arabisch, kyrillisch) (Datenelement 014)"@de .

:geschlechtlicheIdentitaet a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Geschlechtliche Identität"@de ,
               "Gender Identity"@en ;
    rdfs:comment "Geschlechtliche Identität gemäß PStG §45b (Datenelement 015)"@de .

:religionszugehoerigkeit a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Religionszugehörigkeit"@de ,
               "Religious Affiliation"@en ;
    rdfs:comment "Religionszugehörigkeit (Datenelement 016)"@de .

:groesse a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:integer ;
    rdfs:label "Größe"@de ,
               "Height"@en ;
    rdfs:comment "Körpergröße in cm (Datenelement 017)"@de .


:besondereMerkmale a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Besondere Merkmale"@de ,
               "Special Characteristics"@en ;
    rdfs:comment "Besondere körperliche Merkmale (Datenelement 019)"@de .

:lichtbild a owl:DatatypeProperty ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Lichtbild"@de ,
               "Photograph"@en ;
    rdfs:comment "Referenz zum Lichtbild/Foto (Datenelement 020)"@de .


:familienstand a owl:DatatypeProperty ;
    rdfs:subPropertyOf cpov:civilStatus ;
    rdfs:domain cpov:Person ;
    rdfs:range xsd:string ;
    rdfs:label "Familienstand"@de ,
               "Marital Status"@en ;
    rdfs:comment "Siehe http://bamf.de/vocabulary/familienstand für Werteliste"@de .

# Aufenthaltstitel-Attribute
:aufenthaltstitelArt a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:string ;
    rdfs:label "Art des Aufenthaltstitels"@de ,
               "Type of Residence Permit"@en ;
    rdfs:comment "Art des Aufenthaltstitels (Datenelement 026). Siehe http://bamf.de/vocabulary/aufenthaltstitel für Werteliste"@de .

:rechtsgrundlage a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:string ;
    rdfs:label "Rechtsgrundlage"@de ,
               "Legal Basis"@en ;
    rdfs:comment "Rechtsgrundlage des Aufenthaltstitels (z.B. § 25 Abs. 1 AufenthG) (Datenelement 027)"@de .

:befristetBisUnbefristet a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:string ;
    rdfs:label "Befristet/Unbefristet"@de ,
               "Limited/Unlimited"@en ;
    rdfs:comment "Kennzeichen ob befristet oder unbefristet (Datenelement 028)"@de .

:ersteinreisedatum a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:date ;
    rdfs:label "Ersteinreisedatum"@de ,
               "Date of First Entry"@en ;
    rdfs:comment "Datum der Ersteinreise nach Deutschland (Datenelement 029)"@de .

:letzteEinreisedatum a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:date ;
    rdfs:label "Letztes Einreisedatum"@de ,
               "Date of Last Entry"@en ;
    rdfs:comment "Datum der letzten Einreise (Datenelement 030)"@de .

:einreiseort a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Einreiseort"@de ,
               "Place of Entry"@en ;
    rdfs:comment "Ort/Grenzübergangsstelle der Einreise (Datenelement 031)"@de .

:einreiseart a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Einreiseart"@de ,
               "Type of Entry"@en ;
    rdfs:comment "Art der Einreise (legal/illegal) (Datenelement 032)"@de .

:aufenthaltstitelNummer a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:string ;
    rdfs:label "Aufenthaltstitel-Nummer"@de ,
               "Residence Permit Number"@en .

:gueltigVon a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:date ;
    rdfs:label "gültig von"@de ,
               "valid from"@en .


:aufenthaltszweck a owl:DatatypeProperty ;
    rdfs:domain :Aufenthaltstitel ;
    rdfs:range xsd:string ;
    rdfs:label "Aufenthaltszweck"@de ,
               "Purpose of Residence"@en ;
    rdfs:comment "Siehe http://bamf.de/vocabulary/aufenthaltszweck für Werteliste"@de .

# Asylverfahren-Attribute
:verfahrensnummer a owl:DatatypeProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range xsd:string ;
    rdfs:label "Verfahrensnummer"@de ,
               "Procedure Number"@en ;
    rdfs:comment "Geschäftszeichen/Verfahrensnummer (Datenelement 040)"@de .

:bamfEntscheidungsz eichen a owl:DatatypeProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range xsd:string ;
    rdfs:label "BAMF-Entscheidungszeichen"@de ,
               "BAMF Decision Reference"@en ;
    rdfs:comment "Entscheidungszeichen des BAMF (Datenelement 041)"@de .

:dublinfallKennzeichen a owl:DatatypeProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range xsd:boolean ;
    rdfs:label "Dublin-Fall"@de ,
               "Dublin Case"@en ;
    rdfs:comment "Kennzeichen für Dublin-Verfahren (Datenelement 042)"@de .

:zustaendigerDublinst aat a owl:DatatypeProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range xsd:string ;
    rdfs:label "Zuständiger Dublin-Staat"@de ,
               "Responsible Dublin State"@en ;
    rdfs:comment "Zuständiger Mitgliedstaat nach Dublin-Verordnung (Datenelement 043)"@de .

:herkunftsland a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Herkunftsland"@de ,
               "Country of Origin"@en ;
    rdfs:comment "Herkunftsland/Heimatland (Datenelement 044)"@de .

:herkunftsregion a owl:DatatypeProperty ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string ;
    rdfs:label "Herkunftsregion"@de ,
               "Region of Origin"@en ;
    rdfs:comment "Spezifische Region/Provinz im Herkunftsland (Datenelement 045)"@de .

:antragsdatum a owl:DatatypeProperty ;
    rdfs:domain :Asylantrag ;
    rdfs:range xsd:date ;
    rdfs:label "Antragsdatum"@de ,
               "Application Date"@en .

:antragsstatus a owl:DatatypeProperty ;
    rdfs:domain :Asylantrag ;
    rdfs:range xsd:string ;
    rdfs:label "Antragsstatus"@de ,
               "Application Status"@en ;
    rdfs:comment "Z.B. anhängig, entschieden, zurückgezogen"@de .

:entscheidungsdatum a owl:DatatypeProperty ;
    rdfs:domain :Asylentscheidung ;
    rdfs:range xsd:date ;
    rdfs:label "Entscheidungsdatum"@de ,
               "Decision Date"@en .

:entscheidungsart a owl:DatatypeProperty ;
    rdfs:domain :Asylentscheidung ;
    rdfs:range xsd:string ;
    rdfs:label "Entscheidungsart"@de ,
               "Decision Type"@en ;
    rdfs:comment "Art der Asylentscheidung (Datenelement 046). Siehe http://bamf.de/vocabulary/asylentscheidung für Werteliste"@de .

:rechtsmittel a owl:DatatypeProperty ;
    rdfs:domain :Asylverfahren ;
    rdfs:range xsd:string ;
    rdfs:label "Rechtsmittel"@de ,
               "Legal Remedy"@en ;
    rdfs:comment "Eingelegtes Rechtsmittel (Klage, Berufung, Revision) (Datenelement 047)"@de .

