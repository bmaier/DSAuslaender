:vornameNachDeutschemRecht
    a owl:DatatypeProperty ;
    rdfs:label "Vorname nach deutschem Recht"@de ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string  ;
    rdfs:comment "Führt die ausländische Person nach deutschem Recht einen anderen als den im ausländischen Pass angegebenen Vornamen und kann eine Änderung des Passes aus rechtlichen oder tatsächlichen Gründen nicht vorgenommen werden, so wird im Vornamen nach deutschem Recht dieser angegeben. "@de  .
    # Feld 004.05 | SHACL: DE004.05: Vorname nach deutschem Recht

:weitereNebenbestimmungen
    a owl:DatatypeProperty ;
    rdfs:label "Weitere Nebenbestimmungen"@de ;
