    rdfs:range xsd:string  ;
    rdfs:comment "Es sind Teilnummern zur Hausnummer anzugeben."@de  .
    # Feld 006.07 | SHACL: DE006.07: Anschrift - Teilnummer der Hausnummer

:anschriftWohnort
    a owl:DatatypeProperty ;
    rdfs:label "Anschrift - Wohnort"@de ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string  ;
    rdfs:comment "In Abhängigkeit von Datenblatt Nr. 006.12 ist dies entweder die aktuelle oder zuletzt bekannte Anschrift in Deutschland. "@de  .
    # Feld 006.08 | SHACL: DE006.08: Anschrift - Wohnort

:anschriftWohnortFruehererGemeindename
    a owl:DatatypeProperty ;
    rdfs:label "Anschrift - Wohnort früherer Gemeindename"@de ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string  ;
    rdfs:comment "Es ist der frühere Gemeindename anzugeben, der als Stadt- bzw. Ortsteilname dem jetzigen Gemein- denamen hinzugefügt werden kann. Der frühere Gemeindename (jetziger Ortsteil- oder Stadtteilname) ist bei Adressierungen unterhalb des Namens (oberhalb der Straßenbezeichnung) anzugeben"@de  .
    # Feld 006.09 | SHACL: DE006.09: Anschrift - Wohnort früherer Gemeindename

:anschriftWohnungsinhaber
    a owl:DatatypeProperty ;
    rdfs:label "Anschrift - Wohnungsinhaber"@de ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string  ;
    rdfs:comment "In diesem Element ist der Hauptmieter oder Eigentümer der Wohnung anzugeben, soweit dies für die Adressierung erforderlich ist. Bei Überschreitung einer Länge von 26 Zeichen darf sinnvoll abgekürzt werden. In Abhängigkeit von Datenblatt Nr. 006.12 ist dies entweder die aktuelle oder zuletzt bekannte Anschrift in Deutschland. Rechtliche Grundlagen Darstellungsform Bestandteil der Gruppe 006 - Anschrift im Bundesgebiet"@de  .
    # Feld 006.10 | SHACL: DE006.10: Anschrift - Wohnungsinhaber

:anschriftZusatzangaben
    a owl:DatatypeProperty ;
    rdfs:label "Anschrift - Zusatzangaben"@de ;
    rdfs:domain :AuslaendischePerson ;
    rdfs:range xsd:string  ;
    rdfs:comment "Es sind Zusatzangaben zur Anschrift anzugeben. Beispiele: Hinterhaus, Gartenhaus. Bei Überschreitung einer Länge von 21 Zeichen darf sinnvoll abgekürzt werden. In Abhängigkeit von Datenblatt Nr.Datenblatt Nr. 006.12 ist dies entweder die aktuelle oder zuletzt bekannte Anschrift in Deutschland. Rechtliche Grundlagen Darstellungsform Bestandteil der Gruppe 006 - Anschrift im Bundesgebiet 7. Fassung Seite 67"@de  .
    # Feld 006.11 | SHACL: DE006.11: Anschrift - Zusatzangaben

