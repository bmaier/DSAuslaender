    rdfs:range xsd:string .
    # SHACL: Weiterenebenbestimmungen

:zusatzangaben
    a owl:DatatypeProperty ;
    rdfs:label "Zusatzangaben"@de ;
    rdfs:domain :freiwilligGemachteAngabenZurReligionszugehoerigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Zusätzliche Informationen der ausländischen Person zu ihrer Religionszugehörigkeit, die nicht durch Datenblatt Nr. 020.01 erfasst werden können. Auch diese Informationen müssen auf freiwillige Anga- ben beruhen. "@de  .
    # Feld 020.02 | SHACL: DE020.02: Zusatzangaben

:zustaendigeAsylbewerberleistungsbehoerde
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Asylbewerberleistungsbehörde"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Das Behördenkennzeichen der Behörde, die gem. § 10 Asylbewerberleistungsgesetz für Leistungen nach diesem Gesetz örtlich zuständig ist. Die für die Durchführung dieses Gesetzes zuständigen Behörden werden durch die Landesregierungen oder die von ihnen beauftragten obersten Landesbe- hörden bestimmt. Rechtliche Grundlagen AsylbLG: § 10 Darstellungsform Bestandteil der Gruppe 010 - Zuständigkeit"@de  .
    # Feld 010.05 | SHACL: DE010.05: Zuständige Asylbewerberleistungsbehörde

:zustaendigeAsylbewerberleistungsbehoerdeFreitext
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Asylbewerberleistungsbehörde (Freitext)"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Die Bezeichnung der zuständigen Behörde, falls kein Behördenkennzeichen für diese Behörde vor- handen ist. Rechtliche Grundlagen AsylbLG: § 10 Darstellungsform Bestandteil der Gruppe 010 - Zuständigkeit 7. Fassung Seite 81"@de  .
    # Feld 010.06 | SHACL: DE010.06: Zuständige Asylbewerberleistungsbehörde (Freitext)

:zustaendigeAufnahmeeinrichtung
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Aufnahmeeinrichtung"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Das Behördenkennzeichen der Aufnahmeeinrichtung, die für die Unterbringung einer asylsuchenden Person zuständig ist. "@de  .
    # Feld 010.01 | SHACL: DE010.01: Zuständige Aufnahmeeinrichtung

:zustaendigeAufnahmeeinrichtungFreitext
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Aufnahmeeinrichtung (Freitext)"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Die Bezeichnung der zuständigen Behörde, falls kein Behördenkennzeichen für diese Behörde vor- handen ist. Rechtliche Grundlagen AsylG: § 7, § 8, § 45, § 46, §§ 50 - 54 Darstellungsform Bestandteil der Gruppe 010 - Zuständigkeit 7. Fassung Seite 77"@de  .
    # Feld 010.02 | SHACL: DE010.02: Zuständige Aufnahmeeinrichtung (Freitext)

:zustaendigeAuslaenderbehoerde
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Ausländerbehörde"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Das Behördenkennzeichen der Ausländerbehörde, die für den Aufenthalt einer ausländische Person zuständig ist. "@de  .
    # Feld 010.03 | SHACL: DE010.03: Zuständige Ausländerbehörde

:zustaendigeAuslaenderbehoerdeFreitext
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Ausländerbehörde (Freitext)"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Die Bezeichnung der zuständigen Behörde, falls kein Behördenkennzeichen für diese Behörde vor- handen ist. Rechtliche Grundlagen AufenthG: § 71 Abs. 1 Darstellungsform Bestandteil der Gruppe 010 - Zuständigkeit 7. Fassung Seite 79"@de  .
    # Feld 010.04 | SHACL: DE010.04: Zuständige Ausländerbehörde (Freitext)

:zustaendigeAuslandsvertretung
    a owl:DatatypeProperty ;
    rdfs:label "Zuständige Auslandsvertretung"@de ;
    rdfs:domain :vorabzustimmung ;
    rdfs:range xsd:string  ;
    rdfs:comment "Das Behördenkennzeichen der zuständigen Auslandsvertretung. Rechtliche Grundlagen AufenthG: § 81a BeschV: § 36 Darstellungsform Bestandteil der Gruppe 066 - Vorabzustimmung 7. Fassung Seite 409"@de  .
    # Feld 066.05 | SHACL: DE066.05: Zuständige Auslandsvertretung

:zustaendigesBundesland
    a owl:DatatypeProperty ;
    rdfs:label "Zuständiges Bundesland"@de ;
    rdfs:domain :zustaendigkeit ;
    rdfs:range xsd:string  ;
    rdfs:comment "Das Bundesland, in dem sich die zuständige Ausländerbehörde oder Aufnahmeeinrichtung befindet. Rechtliche Grundlagen Darstellungsform urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:bundesland Bestandteil der Gruppe 010 - Zuständigkeit 7. Fassung Seite 86"@de  .
    # Feld 010.11 | SHACL: DE010.11: Zuständiges Bundesland

:zustellungsdatum
    a owl:DatatypeProperty ;
