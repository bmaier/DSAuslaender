    # Feld 074.09 | SHACL: DE074.09: Höhe der Strafe (Höhe Tagessatz)

:hoeheDerStrafeJahre
    a owl:DatatypeProperty ;
    rdfs:label "Höhe der Strafe (Jahre)"@de ;
    rdfs:range xsd:string  ;
    rdfs:comment "Hier wird die Höhe der Strafe in Jahren dokumentiert, sofern eine Straftat zu einer Rückkehrentschei- dung und damit zu einer Ausschreibung im Schengener Informationssystem geführt hat. Darüber hin- ausgehende Monate (oder Wochen, Tage) sind im entsprechenden Feld zu erfassen. "@de  .
    # Feld 074.04 | SHACL: DE074.04: Höhe der Strafe (Jahre)

:hoeheDerStrafeMonate
    a owl:DatatypeProperty ;
    rdfs:label "Höhe der Strafe (Monate)"@de ;
    rdfs:range xsd:string  ;
    rdfs:comment "Hier werden die Höhe der Strafe in Monaten, bzw. die die ganzen Jahre einer Strafe übersteigenden Monate (z. B. 3 Jahre, 3 Monate) dokumentiert, sofern eine Straftat zu einer Rückkehrentscheidung und damit zu einer Ausschreibung im Schengener Informationssystem geführt hat. Darüber hinausgehende Wochen oder Tage sind im entsprechenden Feld zu erfassen. "@de  .
    # Feld 074.05 | SHACL: DE074.05: Höhe der Strafe (Monate)

:hoeheDerStrafeTage
    a owl:DatatypeProperty ;
    rdfs:label "Höhe der Strafe (Tage)"@de ;
    rdfs:range xsd:string  ;
    rdfs:comment "Hier werden die Höhe der Strafe in Tagen, bzw. die die ganzen Jahre, Monate und Wochen einer Strafe übersteigenden Tage (z. B. 3 Wochen, 2 Tage) dokumentiert, sofern eine Straftat zu einer Rückkehr- entscheidung und damit zu einer Ausschreibung im Schengener Informationssystem geführt hat. "@de  .
    # Feld 074.07 | SHACL: DE074.07: Höhe der Strafe (Tage)

:hoeheDerStrafeWochen
    a owl:DatatypeProperty ;
    rdfs:label "Höhe der Strafe (Wochen)"@de ;
