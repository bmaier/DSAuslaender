@prefix : <http://bamf.de/vocabulary/feldlaengentyp#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://bamf.de/vocabulary/feldlaengentyp> a skos:ConceptScheme ;
    dct:title "Feldlängen-Typen DSAusländer"@de ,
              "Field Length Types DSAusländer"@en ;
    dct:description "Klassifikation ob ein Feld eine feste oder variable Länge hat gemäß Datensatzbeschreibung"@de ,
                    "Classification whether a field has fixed or variable length according to dataset specification"@en ;
    dct:created "2025-01-20"^^xsd:date ;
    dct:modified "2025-01-20"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:hasTopConcept :Fest ,
                       :Variabel .

# ============================================================================
# CONCEPTS (Feldlängen-Typen)
# ============================================================================

:Fest a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/feldlaengentyp> ;
    skos:topConceptOf <http://bamf.de/vocabulary/feldlaengentyp> ;
    skos:prefLabel "fest"@de ,
                   "fixed"@en ;
    skos:altLabel "fixe Länge"@de ,
                  "fixed length"@en ;
    skos:notation "F" ;
    skos:definition "Das Feld hat eine feste, nicht variable Länge. Die Anzahl der Zeichen ist exakt vorgegeben und muss eingehalten werden."@de ,
                    "The field has a fixed, non-variable length. The exact number of characters is specified and must be adhered to."@en ;
    skos:example "Behördenkennzeichen (6 Zeichen), Postleitzahl (5 Zeichen), Geschlecht (1 Zeichen)"@de ;
    skos:scopeNote "Wird in SHACL durch sh:minLength = sh:maxLength ausgedrückt"@de ,
                   "Expressed in SHACL through sh:minLength = sh:maxLength"@en ;
    skos:editorialNote "Feste Feldlängen ermöglichen effiziente Speicherung und Validierung, erfordern aber Padding (z.B. mit Nullen oder Leerzeichen) wenn Werte kürzer sind."@de .

:Variabel a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/feldlaengentyp> ;
    skos:topConceptOf <http://bamf.de/vocabulary/feldlaengentyp> ;
    skos:prefLabel "variabel"@de ,
                   "variable"@en ;
    skos:altLabel "variable Länge"@de ,
                  "variable length"@en ;
    skos:notation "V" ;
    skos:definition "Das Feld hat eine variable Länge bis zu einem definierten Maximum. Die tatsächliche Länge kann von 0 bis zum Maximalwert variieren."@de ,
                    "The field has a variable length up to a defined maximum. The actual length can vary from 0 to the maximum value."@en ;
    skos:example "Familienname (max. 100 Zeichen), Straße (max. 100 Zeichen), Geschäftszeichen (max. 50 Zeichen)"@de ;
    skos:scopeNote "Wird in SHACL durch sh:maxLength ausgedrückt (ohne sh:minLength oder mit sh:minLength < sh:maxLength)"@de ,
                   "Expressed in SHACL through sh:maxLength (without sh:minLength or with sh:minLength < sh:maxLength)"@en ;
    skos:editorialNote "Variable Feldlängen sind flexibler für Freitextfelder und Namen, benötigen aber mehr Speicherplatz und komplexere Validierung."@de .

# ============================================================================
# USAGE IN SHACL
# ============================================================================
# In SHACL Shapes wird ex:feldlaengenTyp verwendet:
#
# Beispiel für festes Feld (Behördenkennzeichen, 6 Zeichen):
# :AktenfuehrendeBehoerdeShape a sh:PropertyShape ;
#     sh:path :aktenfuehrendeBehoerde ;
#     ex:feldlaengenTyp feldtyp:Fest ;
#     sh:minLength 6 ;
#     sh:maxLength 6 ;
#     sh:pattern "^[0-9]{6}$" ;
#     sh:datatype xsd:string .
#
# Beispiel für variables Feld (Familienname, max. 100 Zeichen):
# :FamiliennameShape a sh:PropertyShape ;
#     sh:path :familienname ;
#     ex:feldlaengenTyp feldtyp:Variabel ;
#     sh:maxLength 100 ;
#     sh:datatype xsd:string .
