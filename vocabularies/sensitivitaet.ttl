@prefix : <http://bamf.de/vocabulary/sensitivitaet#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://bamf.de/vocabulary/sensitivitaet> a skos:ConceptScheme ;
    dct:title "Sensitivitätsstufen DSAusländer"@de ,
              "Sensitivity Levels DSAusländer"@en ;
    dct:description "Klassifikationsstufen für die Sensitivität von Datenfeldern im DSAusländer-Register gemäß Datenschutz- und Sicherheitsanforderungen"@de ,
                    "Classification levels for data field sensitivity in the DSAusländer register according to data protection and security requirements"@en ;
    dct:created "2025-01-20"^^xsd:date ;
    dct:modified "2025-01-20"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:hasTopConcept :Oeffentlich ,
                       :Intern ,
                       :Vertraulich ,
                       :StrengVertraulich .

# ============================================================================
# CONCEPTS (Sensitivitätsstufen)
# ============================================================================

:Oeffentlich a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:topConceptOf <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:prefLabel "öffentlich"@de ,
                   "public"@en ;
    skos:notation "0" ;
    skos:definition "Daten ohne Zugriffsbeschränkungen, die öffentlich verfügbar sind oder sein können. Diese Informationen unterliegen keinen besonderen Schutzbestimmungen."@de ,
                    "Data without access restrictions that is or can be publicly available. This information is not subject to special protection provisions."@en ;
    skos:example "Allgemeine Statistiken, öffentliche Bekanntmachungen"@de ;
    skos:narrower :Intern .

:Intern a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:topConceptOf <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:prefLabel "intern"@de ,
                   "internal"@en ;
    skos:notation "1" ;
    skos:definition "Daten für den internen Gebrauch innerhalb der Behörde. Der Zugriff ist auf autorisierte Mitarbeiter beschränkt, die diese Information zur Aufgabenerfüllung benötigen."@de ,
                    "Data for internal use within the authority. Access is restricted to authorized personnel who need this information to fulfill their tasks."@en ;
    skos:example "Interne Verwaltungsinformationen, Aktenführung, Verfahrensdaten"@de ;
    skos:broader :Oeffentlich ;
    skos:narrower :Vertraulich .

:Vertraulich a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:topConceptOf <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:prefLabel "vertraulich"@de ,
                   "confidential"@en ;
    skos:notation "2" ;
    skos:definition "Vertrauliche Daten mit beschränktem Zugriff, die besonderen Schutz nach Datenschutzgrundverordnung (DSGVO) und Bundesdatenschutzgesetz (BDSG) erfordern. Unbefugte Offenlegung kann erhebliche Nachteile für betroffene Personen zur Folge haben."@de ,
                    "Confidential data with restricted access requiring special protection under GDPR and Federal Data Protection Act. Unauthorized disclosure may result in significant disadvantages for affected persons."@en ;
    skos:example "Personenbezogene Daten, Aufenthaltsstatus, Familieninformationen, Adressdaten"@de ;
    skos:scopeNote "Umfasst personenbezogene Daten gemäß Art. 4 Nr. 1 DSGVO"@de ;
    skos:broader :Intern ;
    skos:narrower :StrengVertraulich .

:StrengVertraulich a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:topConceptOf <http://bamf.de/vocabulary/sensitivitaet> ;
    skos:prefLabel "streng vertraulich"@de ,
                   "strictly confidential"@en ;
    skos:altLabel "hochsensibel"@de ,
                  "highly sensitive"@en ;
    skos:notation "3" ;
    skos:definition "Höchst sensible Daten mit strengsten Zugriffsbeschränkungen, die besondere Kategorien personenbezogener Daten nach Art. 9 DSGVO betreffen oder deren Offenlegung zu erheblicher Gefährdung von Leib, Leben oder Freiheit führen könnte."@de ,
                    "Highly sensitive data with strictest access restrictions concerning special categories of personal data under Art. 9 GDPR or whose disclosure could lead to significant danger to life, limb or freedom."@en ;
    skos:example "Daten zu Asylgründen, Gesundheitsdaten, biometrische Daten, Information über besondere Schutzbedürftigkeit, Opfer von Menschenhandel"@de ;
    skos:scopeNote "Umfasst besondere Kategorien personenbezogener Daten gemäß Art. 9 DSGVO: rassische/ethnische Herkunft, politische Meinungen, religiöse Überzeugungen, Gewerkschaftszugehörigkeit, Gesundheitsdaten, Sexualleben"@de ;
    skos:editorialNote "Zugriff nur mit höchster Berechtigungsstufe und nachgewiesenem Need-to-know-Prinzip. Besondere technische und organisatorische Maßnahmen nach Art. 32 DSGVO erforderlich."@de ;
    skos:broader :Vertraulich .
