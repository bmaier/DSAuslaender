@prefix : <https://bamf.bund.de/vocab/geschlecht#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix base: <https://bamf.bund.de/vocab/base#> .

# ============================================================================
# GESCHLECHT SKOS-VOKABULAR
#
# Dieses Vokabular verwendet das SKOS-Modell (Simple Knowledge Organization System, https://www.w3.org/2004/02/skos/), 
# einen W3C-Standard zur Repräsentation kontrollierter Vokabulare, Thesauri und Taxonomien im Semantic Web.
# SKOS ermöglicht die strukturierte Beschreibung von Konzepten (z.B. Geschlechtsangaben) mit Labels, Definitionen und Relationen.
# 
# Die Nutzung von SKOS wird von der Europäischen Union als Best Practice für semantische Interoperabilität empfohlen,
# insbesondere im Rahmen des European Interoperability Framework (EIF) und der ISA²-Initiative:
# - https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/eif
# - https://ec.europa.eu/isa2/solutions/semantic-interoperability-community-semic_en
#
# Durch SKOS werden Vokabulare maschinenlesbar, wiederverwendbar und interoperabel zwischen Organisationen und IT-Systemen.
# ============================================================================

<https://bamf.bund.de/vocab/geschlecht> a owl:Ontology , skos:ConceptScheme ;
    owl:imports <https://bamf.bund.de/vocab/base> ;
    dct:title "Geschlecht Vokabular"@de ,
              "Gender Vocabulary"@en ;
    dct:description "Kontrolliertes Vokabular für Geschlechtsangaben gemäß deutscher Rechtslage (§§ 22 und 45 b PStG) und XInneres-Standard"@de ,
                    "Controlled vocabulary for gender information according to German law (§§ 22 and 45 b PStG) and XInneres standards"@en ;
    dct:created "2025-01-19"^^xsd:date ;
    dct:modified "2026-01-29"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:publisher "KoSIT" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://www.xrepository.de/details/urn:xoev-de:xinneres:codeliste:geschlecht> ;
    owl:versionInfo "1.2.2" ;
    # XRepository-Referenz (XInneres)
    base:xRepositoryURN "urn:xoev-de:xinneres:codeliste:geschlecht"^^xsd:anyURI ;
    base:xRepositoryVersion "1" ;
    rdfs:comment "Basiert auf der XInneres-Codeliste Geschlecht (Version 1, gültig ab 01.11.2022). Geschlechtsangaben gemäß §§ 22 und 45 b PStG. Herausgeber: Koordinierungsstelle für IT-Standards (KoSIT)"@de ;
    rdfs:label "Geschlecht Konzeptschema"@de ,
               "Gender Concept Scheme"@en .

# ============================================================================
# GESCHLECHT-KONZEPTE
# ============================================================================

:Maennlich a skos:Concept ;
    skos:inScheme <https://bamf.bund.de/vocab/geschlecht> ;
    skos:prefLabel "Männlich"@de ,
                   "Male"@en ;
    skos:notation "m" ;
    skos:definition "Männliches Geschlecht"@de ,
                    "Male gender"@en ;
    base:xRepositoryID "m" ;
    skos:exactMatch <urn:xoev-de:xinneres:codeliste:geschlecht:m> ;
    skos:topConceptOf <https://bamf.bund.de/vocab/geschlecht> .

:Weiblich a skos:Concept ;
    skos:inScheme <https://bamf.bund.de/vocab/geschlecht> ;
    skos:prefLabel "Weiblich"@de ,
                   "Female"@en ;
    skos:notation "w" ;
    skos:definition "Weibliches Geschlecht"@de ,
                    "Female gender"@en ;
    base:xRepositoryID "w" ;
    skos:exactMatch <urn:xoev-de:xinneres:codeliste:geschlecht:w> ;
    skos:topConceptOf <https://bamf.bund.de/vocab/geschlecht> .

:Divers a skos:Concept ;
    skos:inScheme <https://bamf.bund.de/vocab/geschlecht> ;
    skos:prefLabel "Divers"@de ,
                   "Diverse"@en ;
    skos:notation "d" ;
    skos:definition "Drittes Geschlecht gemäß § 22 Abs. 3 PStG"@de ,
                    "Third gender according to § 22 para. 3 PStG"@en ;
    base:xRepositoryID "d" ;
    skos:exactMatch <urn:xoev-de:xinneres:codeliste:geschlecht:d> ;
    rdfs:comment "Eingeführt durch Gesetz zur Änderung der in das Geburtenregister einzutragenden Angaben (2018). Aufgrund gesetzlicher Vorgaben hinzugefügt."@de ;
    skos:topConceptOf <https://bamf.bund.de/vocab/geschlecht> .

:KeineAngabe a skos:Concept ;
    skos:inScheme <https://bamf.bund.de/vocab/geschlecht> ;
    skos:prefLabel "Keine Angabe"@de ,
                   "Not specified"@en ;
    skos:altLabel "Unbekannt"@de ,
                  "Unknown"@en ,
                  "Ohne Angabe"@de ;
    skos:notation "x" ;
    skos:definition "Geschlecht keine Angabe oder unbekannt"@de ,
                    "Gender not specified or unknown"@en ;
    base:xRepositoryID "x" ;
    skos:exactMatch <urn:xoev-de:xinneres:codeliste:geschlecht:x> ;
    rdfs:comment "Keine Angabe zum Geschlecht (XInneres-Codeliste Version 1)"@de ;
    skos:topConceptOf <https://bamf.bund.de/vocab/geschlecht> .
