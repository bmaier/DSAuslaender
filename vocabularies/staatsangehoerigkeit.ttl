# Sonderfälle
:XXA a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/staatsangehoerigkeit> ;
    skos:prefLabel "Staatenlos"@de ,
                   "Stateless"@en ;
    skos:notation "XXA" ;
    dct:identifier "XXA" ;
    skos:definition "Person ohne Staatsangehörigkeit gemäß Übereinkommen über die Rechtsstellung der Staatenlosen von 1954"@de ;
    :xRepositoryID "TODO_ID" ;
    skos:topConceptOf <http://bamf.de/vocabulary/staatsangehoerigkeit> .

:XXB a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/staatsangehoerigkeit> ;
