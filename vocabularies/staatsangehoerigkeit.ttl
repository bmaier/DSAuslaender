                   "Undetermined"@en ;
    skos:notation "XXB" ;
    dct:identifier "XXB" ;
    skos:definition "Staatsangehörigkeit konnte nicht geklärt werden"@de ;
    :xRepositoryID "TODO_ID" ;
    skos:topConceptOf <http://bamf.de/vocabulary/staatsangehoerigkeit> .

:XXC a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/staatsangehoerigkeit> ;
    skos:prefLabel "Ohne Angabe"@de ,
                   "Not specified"@en ;
