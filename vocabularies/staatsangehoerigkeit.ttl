:DEU a skos:Concept ;
    skos:inScheme <http://bamf.de/vocabulary/staatsangehoerigkeit> ;
    skos:prefLabel "Deutschland"@de ,
                   "Germany"@en ;
    skos:notation "DEU" ;
    dct:identifier "DEU" ;
    skos:definition "Bundesrepublik Deutschland"@de ;
    :xRepositoryID "TODO_ID" ;
    rdfs:comment "XRepository-ID muss aus Codeliste ergänzt werden (Destatis-Code)"@de ;
    skos:topConceptOf <http://bamf.de/vocabulary/staatsangehoerigkeit> .

