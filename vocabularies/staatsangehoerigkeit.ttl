# ============================================================================
# STAATSANGEHÖRIGKEIT SKOS-VOKABULAR
#
# Dieses Vokabular verwendet das SKOS-Modell für Staatsangehörigkeiten basierend
# auf der offiziellen DESTATIS-Codeliste (Statistisches Bundesamt).
# Die DESTATIS-Schlüssel sind numerische Codes, die in deutschen Behörden verwendet werden.
# ============================================================================

<https://bamf.bund.de/vocab/staatsangehoerigkeit> a owl:Ontology , skos:ConceptScheme ;
    owl:imports <https://bamf.bund.de/vocab/base> ;
    dct:title "Staatsangehörigkeit Vokabular"@de ,
              "Citizenship Vocabulary"@en ;
    dct:description "Kontrolliertes Vokabular für Staatsangehörigkeiten basierend auf DESTATIS-Codeliste und ISO 3166-1"@de ,
                    "Controlled vocabulary for citizenships based on DESTATIS codelist and ISO 3166-1"@en ;
    dct:created "2025-01-19"^^xsd:date ;
    dct:modified "2026-01-29"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:publisher "DESTATIS" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0.1" ;
    # XRepository-Referenz (DESTATIS)
    base:xRepositoryURN "urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:staatsangehoerigkeit"^^xsd:anyURI ;
    base:xRepositoryVersion "2024-08-01" ;
    dct:source <https://www.xrepository.de/details/urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:staatsangehoerigkeit> ;
    dct:conformsTo <https://www.iso.org/iso-3166-country-codes.html> ;
    rdfs:comment "Basiert auf der DESTATIS-Codeliste Staatsangehörigkeit (Version 2024-08-01). Verwendet ISO 3166-1 Alpha-3 Ländercodes als Notation und DESTATIS-numerische Schlüssel."@de ;
    rdfs:label "Staatsangehörigkeit Konzeptschema"@de ,
               "Citizenship Concept Scheme"@en .

