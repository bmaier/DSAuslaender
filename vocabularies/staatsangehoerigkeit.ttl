@prefix : <http://bamf.de/vocabulary/staatsangehoerigkeit#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

# ============================================================================
# STAATSANGEHÖRIGKEIT SKOS-VOKABULAR
# ============================================================================

<http://bamf.de/vocabulary/staatsangehoerigkeit> a owl:Ontology , skos:ConceptScheme ;
    dct:title "Staatsangehörigkeit Vokabular"@de ,
              "Citizenship Vocabulary"@en ;
    dct:description "Kontrolliertes Vokabular für Staatsangehörigkeiten basierend auf ISO 3166-1 und XRepository"@de ,
                    "Controlled vocabulary for citizenships based on ISO 3166-1 and XRepository"@en ;
    dct:created "2025-01-19"^^xsd:date ;
    dct:modified "2025-01-19"^^xsd:date ;
    dct:creator "BAMF" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.0" ;
    # XRepository-Referenz (XÖV-Kernkomponente)
    :xRepositoryURN <https://www.xrepository.de/api/xrepository/urn:xoev-de:kosit:xoev:kernkomponente:staatsangehoerigkeit> ;
    dct:source <https://www.xrepository.de/details/urn:xoev-de:kosit:xoev:kernkomponente:staatsangehoerigkeit> ;
    dct:conformsTo <https://www.iso.org/iso-3166-country-codes.html> ;
    rdfs:comment "Basiert auf der XÖV-Kernkomponente Staatsangehörigkeit (Code.Staatsangehoerigkeit). Verwendet ISO 3166-1 Alpha-3 Ländercodes als Notation."@de ;
    rdfs:label "Staatsangehörigkeit Konzeptschema"@de ,
               "Citizenship Concept Scheme"@en .

# Property-Definitionen für XRepository
:xRepositoryURN a owl:AnnotationProperty ;
    rdfs:label "XRepository URN"@de ;
    rdfs:range xsd:anyURI .

:xRepositoryID a owl:DatatypeProperty ;
    rdfs:label "XRepository ID"@de ;
    rdfs:range xsd:string .

# ============================================================================
# STAATSANGEHÖRIGKEITS-KONZEPTE
# Häufigste Staatsangehörigkeiten im deutschen Ausländerregister
